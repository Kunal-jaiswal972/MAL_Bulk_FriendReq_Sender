# MAL login credentials used for automatic login.
# Copy this file to ".env" (which is gitignored) and fill in your account.
# If omitted, the app falls back to manual login (it opens the login page and waits).

MAL_USERNAME=your_mal_username
MAL_PASSWORD=your_mal_password

# Run Chrome without a visible window (for servers / prod). true|1|yes|on to enable.
# NOTE: headless requires MAL_USERNAME/MAL_PASSWORD above — manual login needs a window.
HEADLESS=false
